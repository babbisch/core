{
    "name": "lmonext-org/core",
    "type": "project",
    "description": "Liga Manager Online next (or LMOnext for short) is free PHP software for managing sports leagues and their standings online using a database.",
    "homepage": "https://github.com/lmonext-org/core",
    "version": "1.11.6",
    "time": "2026-09-27",
    "keywords": [
        "LMOnext",
        "Liga Manager Online next Generation",
        "Sportligen verwalten",
        "Manage sports leagues",
        "Gestionar ligas deportivas",
        "Gestire i campionati sportivi",
        "Beheer sportcompetities",
        "Gérer les ligues sportives"
    ],
    "license": "GPL-3.0-only",
    "authors": [
        {
            "name": "Dietmar",
            "homepage": "https://www.liga-manager-online.org",
            "role": "Developer"
        },
        {
            "name": "Torsten",
            "homepage": "https://github.com/webfalter",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2.0",
        "vlucas/phpdotenv": "^5.6.4"
    },
    "autoload": {
        "psr-4": {
            "LMOnext\\": "src/"
        }
    },
    "extra": {
        "display-name": "Liga Manager Online next",
        "check": "https://www.liga-manager-online.org/check_version.json"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
